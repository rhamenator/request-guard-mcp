[
  {
    "name": "evaluate_egress",
    "title": "Evaluate proposed egress",
    "description": "Advisory URL and payload policy preview without opening a network connection; not authorization for a later fetch.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "POST"
          ]
        },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "body_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 1398104
        }
      },
      "required": [
        "url"
      ]
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ALLOW",
            "WARN",
            "BLOCKED"
          ]
        },
        "rule": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "location": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "severity"
            ]
          }
        },
        "canonical_url": {
          "type": "string"
        },
        "resolved_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "rule",
        "remediation",
        "correlation_id",
        "findings"
      ]
    }
  },
  {
    "name": "guarded_fetch",
    "title": "Guarded HTTP fetch",
    "description": "Execute one bounded HTTP(S) request through server-enforced egress policy; each redirect and resolved address is revalidated.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "POST"
          ]
        },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "body_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 1398104,
          "description": "Optional request body, at most 1 MiB decoded. POST only."
        },
        "accept": {
          "type": "string",
          "enum": [
            "text",
            "html",
            "json"
          ]
        },
        "max_return_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      },
      "required": [
        "url"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "body_base64"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "const": "POST"
              }
            },
            "required": [
              "method"
            ]
          }
        }
      ]
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ALLOW",
            "WARN",
            "BLOCKED"
          ]
        },
        "rule": {
          "type": "string"
        },
        "remediation": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "location": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "severity"
            ]
          }
        },
        "final_url": {
          "type": "string"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "content_type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "rule",
        "remediation",
        "correlation_id",
        "findings",
        "truncated",
        "elapsed_ms"
      ]
    }
  },
