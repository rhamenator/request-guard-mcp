{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassifyRequest",
  "type": "object",
  "properties": {
    "ip": { "type": "string", "description": "Client IP address" },
    "user_agent": { "type": "string", "description": "HTTP User-Agent header value" },
    "path": { "type": "string", "description": "Request path" },
    "method": { "type": "string", "enum": ["GET","POST","PUT","PATCH","DELETE","HEAD","OPTIONS"] },
    "headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "body_snippet": { "type": "string", "description": "First 512 bytes of request body" },
    "referer": { "type": "string" },
    "accept": { "type": "string" },
    "request_id": { "type": "string", "description": "Optional idempotency / correlation ID" },
    "timestamp": { "type": "string", "format": "date-time" },
    "tls_ja3": { "type": "string", "pattern": "^[0-9A-Fa-f]{32}$", "description": "JA3 digest collected by trusted TLS infrastructure" },
    "tls_ja4": { "type": "string", "pattern": "^[A-Za-z0-9]{10}_[0-9A-Fa-f]{12}_[0-9A-Fa-f]{12}$", "description": "Canonical JA4 value collected by trusted TLS infrastructure" },
    "tls_fingerprint_source": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$", "description": "Trusted collector or CDN that supplied the fingerprint" },
    "extra": { "type": "object", "description": "Arbitrary extra signals" }
  }
}
