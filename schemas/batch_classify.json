{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BatchClassifyRequest",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "classify.json" },
      "minItems": 0,
      "description": "The server enforces a configurable maximum batch size (default 50)."
    },
    "options": {
      "type": "object",
      "properties": {
        "fail_fast": { "type": "boolean", "default": false },
        "include_details": { "type": "boolean", "default": true, "description": "When false, omit per-item signal details; omitted preserves the full response." }
      }
    }
  }
}
