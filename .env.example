# Server
MCP__HOST=0.0.0.0
MCP__PORT=8085
LOG_LEVEL=info

# Auth - comma-separated tokens (required when auth.enabled=true)
AUTH_TOKENS=replace_me_with_a_strong_token

# Server-side HMAC key (>= 32 bytes) for deriving per-caller cache scopes
# from bearer tokens. Optional: without it a process-local random key is used,
# which is safe but makes cached classifications caller-scope-unstable across
# restarts and replicas. Never reuse a bearer token as this key.
# CACHE_SCOPE_HMAC_KEY=replace_me_with_32_or_more_random_bytes

# Trusted TLS provenance. Use the same random >=32-byte secret in upstream
# collectors/forwarders; never reuse AUTH_TOKENS or CACHE_SCOPE_HMAC_KEY.
# TLS_FINGERPRINT_ATTESTATION_KEY=replace_me_with_32_or_more_random_bytes
# During rotation only; accepted by verifiers but never used to sign.
# TLS_FINGERPRINT_ATTESTATION_PREVIOUS_KEY=replace_me_with_the_old_random_key
TLS_FINGERPRINT_ATTESTATION_MAX_AGE_SECONDS=60
# TLS_KNOWN_BAD_JA3=72a589da586844d7f0818ce684948eea
# TLS_KNOWN_BAD_JA4=t13d1516h2_8daaf6152771_e5627efa2ab1

# Limits
MCP__LIMITS__MAX_REQUEST_BYTES=1048576
MCP__LIMITS__MAX_BATCH_SIZE=50
MCP__LIMITS__GLOBAL_CONCURRENCY=256
MCP__LIMITS__MAX_CONNECTIONS=256
MCP__LIMITS__WEBSOCKET_IDLE_TIMEOUT_SECS=60
MCP__LIMITS__PER_TOOL_TIMEOUT_SECS=30
MCP__LIMITS__CLASSIFY_TIMEOUT_SECS=5

# Optional: Redis (for distributed caching, threat/reputation data, canaries,
# and queue telemetry)
# MCP__REDIS__URL=redis://localhost:6379
MCP__REDIS__POOL_SIZE=16
MCP__REDIS__KEY_PREFIX=request_guard
MCP__REDIS__CACHE_TTL_SECS=300

# Optional: PostgreSQL (for feedback/audit persistence)
# Format: ******HOST:5432/DBNAME
# MCP__POSTGRES__URL=<scheme>://<user>:<pass>@localhost:5432/mcp
MCP__POSTGRES__MAX_CONNECTIONS=10
MCP__POSTGRES__CONNECT_TIMEOUT_SECS=5

# Optional: GeoIP (MaxMind MMDB path)
# MCP__GEOIP__CITY_MMDB_PATH=/data/GeoLite2-City.mmdb
# MCP__GEOIP__ASN_MMDB_PATH=/data/GeoLite2-ASN.mmdb
# MCP__GEOIP__ANONYMOUS_IP_MMDB_PATH=/data/GeoIP2-Anonymous-IP.mmdb

# Optional: OpenTelemetry
# MCP__TELEMETRY__OTLP_ENDPOINT=http://otel-collector:4317
MCP__TELEMETRY__SERVICE_NAME=request-guard-mcp

# Feature flags
MCP__FEATURES__ENABLE_BATCH=true
MCP__FEATURES__ENABLE_ENRICHMENT=true
MCP__FEATURES__ENABLE_FEEDBACK=true

# Client repos - these env vars go in the consuming service, not this server
# MODEL_URI=mcp://primary/classify
# MCP_SERVER_PRIMARY_TRANSPORT=ws
# MCP_SERVER_PRIMARY_URL=ws://request-guard-mcp:8085/mcp
# MCP_SERVER_PRIMARY_AUTH_TOKEN=replace_me
# MCP_SERVER_PRIMARY_TIMEOUT=10
